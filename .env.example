# ---------------------------------------------------------------
# Trust Manager environment variables
# Copy this file to .env.local and fill in values. Never commit .env.local.
# ---------------------------------------------------------------

# "local"    = development mode: data stays in the browser, demo household included (default)
# "supabase" = use your Supabase project (requires the two values below)
NEXT_PUBLIC_DATA_MODE=local

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (never prefix with NEXT_PUBLIC_). Not needed yet.
# SUPABASE_SERVICE_ROLE_KEY=
# OCR_PROVIDER=mock
# AI_PROVIDER_API_KEY=
